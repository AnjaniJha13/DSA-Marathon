class Solution {
    public int findMaxK(int[] nums) {
        Arrays.sort(nums);
        int n = nums.length;
        int result = -1;
        int i = 0;
        int j =  n - 1;

        while ( i < j){
            int left = nums[i];
            int right = nums[j];

            if(right == -left){
                result = Math.max(result , right);
                i++;
                j--;
            }else if (Math.abs(left) > right) {
                i++;
            }else {
                j--;
            }
        }
        return result;  
       
    }
}
