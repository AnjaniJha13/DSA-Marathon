class Solution {
    public int[][] insert(int[][] intervals, int[] newInterval) {
        if (intervals == null || intervals.length == 0) {
            return new int[][]{newInterval};
        }

        // Storing values in list
        List<int[]> merged = new ArrayList<>();

        // Initialize with new interval
        int start1 = newInterval[0];
        int end1 = newInterval[1];

        // Traverse existing intervals
        for (int i = 0; i < intervals.length; i++) {
            int start2 = intervals[i][0];
            int end2 = intervals[i][1];

            // Case 1: Non-overlapping interval before newInterval
            if (end2 < start1) {
                merged.add(new int[]{start2, end2});
            }
            // Case 2: Non-overlapping interval after newInterval
            else if (start2 > end1) {
                merged.add(new int[]{start1, end1});
                start1 = start2;
                end1 = end2;
            }
            // Case 3: Overlapping interval
            else {
                start1 = Math.min(start1, start2);
                end1 = Math.max(end1, end2);
            }
        }

        // Add the last interval
        merged.add(new int[]{start1, end1});

        // Convert list into array
        return merged.toArray(new int[merged.size()][]);
    }
}
